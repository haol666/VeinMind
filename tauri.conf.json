{
  "$schema": "https://schema.tauri.app/config/1.6",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "frontend",
    "distDir": "frontend",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "VeinMind",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": { "all": true, "open": true, "save": true },
      "fs": { "all": true, "scope": ["$DOCUMENT/*", "$DOWNLOAD/*"] },
      "path": { "all": true }
    },
    "bundle": {
      "active": true,
      "category": "Productivity",
      "copyright": "© 2026 VeinMind",
      "deb": { "depends": [] },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.veinmind.app",
      "longDescription": "A mind mapping tool built with Rust + Tauri.",
      "macOS": { "entitlements": null, "exceptionDomain": "", "frameworks": [], "providerShortName": null, "signingIdentity": null },
      "resources": [],
      "shortDescription": "Mind mapping tool",
      "targets": "all",
      "windows": { "certificateThumbprint": null, "digestAlgorithm": "sha256", "timestampUrl": "" }
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "VeinMind - 思维导图工具",
        "width": 1200,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  }
}
